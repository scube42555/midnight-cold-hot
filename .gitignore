# Build output and dependencies (rebuilt from the lockfile)
node_modules
dist
*.tsbuildinfo

# Secrets and wallet data: NEVER commit. The pre-commit hook also blocks these by name.
.env
.env.*
!.env.example
wallet-state-*.json
*.snapshot.json
tx.hex
cold-public.json
*.mqr
*-qr.html
received-*

# Cold bundle material: built per machine, large, and not source
cold-bundle*
*.tar.gz
pylibs/
wheels/
__pycache__/

# Editors, OS, logs
.DS_Store
*.log
